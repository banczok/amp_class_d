# UART0 (GPIO20/21) is the link to the Pico, so the console has to move
# to the C3's built-in USB Serial/JTAG on GPIO18/19.  That is the same
# USB-C socket used for flashing, so nothing extra is needed to see logs.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ESP-NOW receive has to stay live: this radio is what wakes the
# amplifier, and there is no second path to it.
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# 80 MHz is plenty for a UART bridge and halves the CPU draw on the
# always-on rail.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=80

# The C3 SuperMini has 4 MB of flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Keep the watchdog honest about the RX task.
CONFIG_ESP_TASK_WDT_INIT=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
